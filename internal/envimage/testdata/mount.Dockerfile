# Odooboat environment image (ADR 0008 §11, amendment A3). Generated by the
# odooboat binary; its content is part of the image identity.
#
# No syntax directive: it would make the builder pull a frontend image.

FROM ghcr.io/x/odooboat/odoo@sha256:1111111111111111111111111111111111111111111111111111111111111111 AS base

# The builder turns only the requirements the base venv does not already
# satisfy into wheels. Compilers and headers stay in this stage.
FROM base AS builder
USER root
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential pkg-config \
        libpq-dev libldap2-dev libsasl2-dev libxml2-dev libxslt1-dev \
        libjpeg-dev zlib1g-dev libfreetype-dev liblcms2-dev libwebp-dev \
        libffi-dev libssl-dev; \
    rm -rf /var/lib/apt/lists/*
COPY odoo/build-constraints.txt /tmp/odooboat/build-constraints.txt
COPY requirements/ /tmp/odooboat/requirements/
RUN set -eux; \
    venv=/opt/odooboat/venv/bin/python; \
    pip() { uv tool run --python "$venv" --from "pip==26.3" pip "$@"; }; \
    mkdir -p /wheels; \
    pip --python "$venv" install --quiet --dry-run --disable-pip-version-check \
        --report /tmp/odooboat/report.json \
        --requirement /tmp/odooboat/requirements/community.txt; \
    "$venv" -I -c 'import json, sys; [print("%s==%s" % (i["metadata"]["name"], i["metadata"]["version"])) for i in json.load(open(sys.argv[1]))["install"]]' \
        /tmp/odooboat/report.json > /tmp/odooboat/missing.txt; \
    if [ -s /tmp/odooboat/missing.txt ]; then \
        cat /tmp/odooboat/missing.txt; \
        pip wheel --quiet --disable-pip-version-check --no-deps \
            --build-constraint /tmp/odooboat/build-constraints.txt \
            --wheel-dir /wheels --requirement /tmp/odooboat/missing.txt; \
    fi

FROM base
USER root
ARG DEBIAN_FRONTEND=noninteractive

# PostgreSQL client tools of the server's major version (ADR 0008 §6), from
# the PostgreSQL project's repository, signed by the embedded key.
COPY pgdg.asc /etc/apt/keyrings/pgdg.asc
RUN set -eux; \
    . /etc/os-release; \
    echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql-client-16; \
    rm -rf /var/lib/apt/lists/*

# Requirements are installed from the builder's wheels, mounted rather than
# copied, so the image gains only the packages that changed.
COPY requirements/ /opt/odooboat/environment/requirements/
RUN --mount=type=bind,from=builder,source=/wheels,target=/tmp/odooboat/wheels \
    set -eux; \
    uv pip install --python /opt/odooboat/venv/bin/python --no-index \
        --find-links /tmp/odooboat/wheels \
        --requirement /opt/odooboat/environment/requirements/community.txt

# Directories first: COPY --chmod would give its own mode to the parent it
# creates, leaving it untraversable for the execution user. run/ receives the
# generated odoo.conf of each container before it starts (ADR 0009 §3).
RUN install -d -m 0755 /opt/odooboat/helper /opt/odooboat/run
COPY --chmod=0644 helper/odooboat_helper.py /opt/odooboat/helper/odooboat_helper.py

# The check runs as the execution user, so a file it cannot read fails the
# build instead of the first up.
USER 1000:1000
RUN python -I /opt/odooboat/helper/odooboat_helper.py check --series 18.0 --postgres-major 16
